{
  "ConnectionStrings": {
    "LittleBloom": "Server=localhost;Database=LittleBloom;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Auth": {
    "AccessTokenMinutes": 720,
    "RefreshTokenDays": 30,
    "OtpLifetimeSeconds": 300,
    "MaxOtpRequestsPer10Min": 5,
    "AcceptDevCode": false
  },
  "Jwt": {
    "Issuer": "little-bloom-api",
    "Audience": "little-bloom-app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
